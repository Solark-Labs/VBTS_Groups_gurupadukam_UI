rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin registry: readable only by the admin user itself, writable only via Firebase Console / Admin SDK
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Users: users can read/write their own profile, but CANNOT self-escalate to role == 'admin'
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['user', 'purohit'];
      allow update: if isSignedIn()
        && (
          (request.auth.uid == uid && request.resource.data.role == resource.data.role)
          || isAdmin()
        );
      allow delete: if isAdmin();
    }

    // Public catalog collections: anyone can read, only Admin (or verified Purohit for their own profile) can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /purohits/{purohitId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /aparaPeetas/{peetaId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Bookings, Apara Bookings, Orders, Tickets, Wallets
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /aparaBookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /wallets/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}

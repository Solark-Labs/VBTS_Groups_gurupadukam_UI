# Server Configuration
PORT=8080
NODE_ENV=production

# Auth & Security (generate strong random 32+ char secrets)
JWT_SECRET=replace_with_strong_random_secret
APP_PROXY_KEY=replace_with_rotated_proxy_key

# Supabase (Phase 1 Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Cashfree Payment Gateway (Phase 1 & 2)
CASHFREE_ENV=PRODUCTION
CASHFREE_APP_ID=replace_with_cashfree_app_id
CASHFREE_SECRET_KEY=replace_with_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=replace_with_cashfree_webhook_secret

# Meta WhatsApp Business Cloud API (Phase 1 OTP & Phase 3 Agent)
WHATSAPP_TOKEN=replace_with_meta_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_VERIFY_TOKEN=replace_with_webhook_verify_token

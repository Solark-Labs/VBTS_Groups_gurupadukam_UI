# Server port (Hostinger injects PORT automatically; local default is 5000)
PORT=5000
API_BACKEND_HOST=0.0.0.0

# Cashfree Payment Gateway (set CASHFREE_ENV=PRODUCTION with live keys when going live)
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Optional: CORS origin (e.g. https://gurupadukam.com)
CORS_ORIGIN=

# Optional: Vertex AI Proxy (required only for PadukaAI live proxy)
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=
PROXY_HEADER=
